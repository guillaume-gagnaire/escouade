{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["svelte", "vite/client", "node"],
    "strict": true,
    "noEmit": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "allowJs": true,
    "checkJs": false,
    "paths": {
      "$shared/*": ["./src/*"],
      "@escouade/capacitor-mobile": ["./apps/mobile-plugin/src/index.ts"],
      "@capacitor/core": ["./apps/mobile/node_modules/@capacitor/core"],
      "@capacitor/barcode-scanner": ["./apps/mobile/node_modules/@capacitor/barcode-scanner"]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.svelte",
    "vite.config.ts",
    "vitest.config.ts",
    "tests/**/*.ts",
    "playwright.config.ts",
    "apps/mobile-plugin/test/**/*.ts",
    "apps/mobile/src/**/*.ts",
    "apps/mobile/src/**/*.svelte",
    "apps/mobile/vite.config.ts",
    "apps/mobile/e2e/**/*.ts",
    "apps/mobile/scripts/**/*.ts"
  ]
}
