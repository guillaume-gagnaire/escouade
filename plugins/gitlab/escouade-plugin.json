{
  "$schema": "https://escouade.dev/schemas/plugin-1.json",
  "id": "dev.escouade.gitlab",
  "name": "GitLab",
  "version": "2.2.0",
  "description": {
    "fr": "Les issues dans le Kanban, les MR, les pipelines, les discussions et les déploiements de tes projets GitLab, sur gitlab.com et tes instances.",
    "en": "Issues in the Kanban, merge requests, pipelines, discussions and deployments of your GitLab projects, on gitlab.com and your instances."
  },
  "author": { "name": "Escouade", "url": "https://escouade.dev" },
  "license": "GPL-3.0-or-later",
  "repository": "https://github.com/guillaume-gagnaire/escouade/tree/main/plugins/gitlab",
  "categories": ["ticket-sources", "forges"],
  "escouade": { "api": "1", "min": "2.2.0" },
  "run": { "wasm": "Cargo.toml" },
  "activation": ["account:gitlab"],
  "permissions": {
    "network": ["gitlab.com", "{account}"],
    "secrets": ["account:*"]
  },
  "limits": { "fetchSeconds": 15, "fetchBytes": 8388608 },
  "contributes": {
    "accounts": [
      {
        "id": "gitlab",
        "name": "GitLab",
        "defaultHost": "gitlab.com",
        "selfHosted": true,
        "probe": "/api/v4/version",
        "connect": ["token", { "cli": "glab", "login": "glab auth login" }],
        "fields": [{ "key": "url" }, { "key": "token", "secret": true }],
        "scopes": ["api"],
        "tokenPage": "https://gitlab.com/-/user_settings/personal_access_tokens?name=Escouade&scopes=api"
      }
    ],
    "ticketSources": [{ "id": "gitlab", "name": "GitLab Issues", "account": "gitlab" }],
    "forges": [{ "id": "gitlab", "name": "GitLab", "account": "gitlab" }]
  }
}
