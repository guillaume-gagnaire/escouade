{
  "$schema": "https://escouade.dev/schemas/plugin-1.json",
  "id": "dev.escouade.clickup",
  "name": "ClickUp",
  "version": "2.2.0",
  "description": {
    "fr": "Les tâches d'une liste ClickUp dans le Kanban, ses statuts comme colonnes.",
    "en": "A ClickUp list's tasks in the Kanban, its statuses as columns."
  },
  "author": { "name": "Escouade", "url": "https://escouade.dev" },
  "license": "GPL-3.0-or-later",
  "repository": "https://github.com/guillaume-gagnaire/escouade/tree/main/plugins/clickup",
  "escouade": { "api": "1", "min": "2.2.0" },
  "run": { "wasm": "Cargo.toml" },
  "activation": ["account:clickup"],
  "permissions": {
    "network": ["api.clickup.com"],
    "secrets": ["account:clickup"]
  },
  "contributes": {
    "accounts": [
      {
        "id": "clickup",
        "name": "ClickUp",
        "defaultHost": "app.clickup.com",
        "connect": ["token"],
        "fields": [
          {
            "key": "token",
            "secret": true,
            "missing": { "fr": "Indique le jeton.", "en": "Give the token." }
          }
        ],
        "tokenPage": "https://app.clickup.com/settings/apps"
      }
    ],
    "ticketSources": [{ "id": "clickup", "name": "ClickUp", "account": "clickup" }]
  }
}
