{
  "$schema": "https://escouade.dev/schemas/plugin-1.json",
  "id": "dev.escouade.bitbucket",
  "name": "Bitbucket",
  "version": "2.2.3",
  "description": {
    "fr": "Les PR, les statuts, les pipelines, leurs journaux, les commentaires et les déploiements de tes dépôts Bitbucket Cloud.",
    "en": "Pull requests, statuses, pipelines, their logs, comments and deployments of your Bitbucket Cloud repositories."
  },
  "author": { "name": "Escouade", "url": "https://escouade.dev" },
  "license": "GPL-3.0-or-later",
  "repository": "https://github.com/guillaume-gagnaire/escouade/tree/main/plugins/bitbucket",
  "categories": ["forges"],
  "escouade": { "api": "1", "min": "2.2.0" },
  "run": { "wasm": "Cargo.toml" },
  "activation": ["account:bitbucket"],
  "permissions": {
    "network": ["api.bitbucket.org"],
    "secrets": ["account:*"]
  },
  "limits": { "fetchSeconds": 15, "fetchBytes": 8388608 },
  "contributes": {
    "accounts": [
      {
        "id": "bitbucket",
        "name": "Bitbucket",
        "defaultHost": "bitbucket.org",
        "connect": ["token"],
        "fields": [{ "key": "email" }, { "key": "token", "secret": true }],
        "scopes": [
          "read:user:bitbucket",
          "read:repository:bitbucket",
          "read:pullrequest:bitbucket",
          "write:pullrequest:bitbucket",
          "read:pipeline:bitbucket"
        ],
        "tokenPage": "https://id.atlassian.com/manage-profile/security/api-tokens"
      }
    ],
    "forges": [{ "id": "bitbucket", "name": "Bitbucket", "account": "bitbucket" }]
  },
  "store": { "categories": ["forges"], "docs": "docs" }
}
