{
  "$schema": "https://escouade.dev/schemas/plugin-1.json",
  "id": "dev.escouade.codex",
  "name": "Codex",
  "version": "2.2.3",
  "description": {
    "fr": "Codex d'OpenAI comme harness : la conversation, sa vue terminal, les permissions, le plan et le coût par compte.",
    "en": "OpenAI's Codex as a harness: the conversation, its terminal view, permissions, the plan and the cost per account."
  },
  "author": {
    "name": "Escouade",
    "url": "https://escouade.dev"
  },
  "license": "GPL-3.0-or-later",
  "repository": "https://github.com/guillaume-gagnaire/escouade/tree/main/plugins/codex",
  "escouade": {
    "api": "1",
    "min": "2.2.0"
  },
  "run": { "wasm": "Cargo.toml" },
  "limits": { "memoryBytes": 268435456, "turnSeconds": 10 },
  "permissions": {
    "files": [
      { "root": "agentRepo", "access": "read" },
      { "root": "agentHome", "access": "read" }
    ]
  },
  "contributes": {
    "harnesses": [
      {
        "id": "codex",
        "name": "Codex",
        "speaker": "Codex",
        "locate": { "names": ["codex"] },
        "versionArgs": ["--version"],
        "tested": { "oldest": "0.163.0", "newest": "0.163.0" },
        "caps": {
          "modes": ["auto", "default", "plan", "acceptEdits", "bypassPermissions"],
          "effort": true,
          "images": true,
          "slashCommands": true,
          "terminalView": true,
          "readOnly": true
        },
        "models": [{ "id": "gpt-6-luna", "label": "GPT-6-Luna", "effort": true }],
        "efforts": ["low", "medium", "high", "xhigh", "max"],
        "accountVar": "CODEX_HOME",
        "opens": true,
        "install": {
          "windows": "npm install -g @openai/codex",
          "unix": "npm install -g @openai/codex"
        },
        "updateCommand": "npm install -g @openai/codex@latest"
      }
    ]
  },
  "store": { "categories": ["harness"], "docs": "docs" }
}
