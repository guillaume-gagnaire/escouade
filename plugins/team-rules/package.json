{
  "name": "escouade-plugin-team-rules",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "esbuild src/main.ts --bundle --platform=node --format=esm --target=node20 --outfile=dist/plugin.mjs",
    "typecheck": "tsc",
    "test": "node --test test/*.test.ts",
    "validate": "escouade-plugin validate . --first-party",
    "bench": "npm run build && escouade-plugin test . --first-party",
    "dev": "npm run build && escouade-plugin dev . --first-party",
    "archive": "npm run build && escouade-plugin pack . --first-party"
  },
  "devDependencies": {
    "@escouade-dev/plugin": "file:../../sdk/plugin",
    "@types/node": "^22.0.0",
    "esbuild": "0.25.12",
    "typescript": "^6.0.0"
  }
}
