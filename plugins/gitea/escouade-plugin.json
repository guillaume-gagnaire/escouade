{
  "$schema": "https://escouade.dev/schemas/plugin-1.json",
  "id": "dev.escouade.gitea",
  "name": "Gitea / Forgejo",
  "version": "2.2.2",
  "description": {
    "fr": "Les PR, la CI (statuts et Actions), les relectures et le merge de tes dépôts Gitea, Forgejo et Codeberg, sur un seul compte.",
    "en": "Pull requests, CI (statuses and Actions), reviews and merging of your Gitea, Forgejo and Codeberg repositories, on one account."
  },
  "author": { "name": "Escouade", "url": "https://escouade.dev" },
  "license": "GPL-3.0-or-later",
  "repository": "https://github.com/guillaume-gagnaire/escouade/tree/main/plugins/gitea",
  "categories": ["forges"],
  "escouade": { "api": "1", "min": "2.2.0" },
  "run": { "wasm": "Cargo.toml" },
  "activation": ["account:gitea"],
  "permissions": {
    "network": ["codeberg.org", "gitea.com", "{account}"],
    "secrets": ["account:*"]
  },
  "limits": { "fetchSeconds": 15, "fetchBytes": 8388608 },
  "contributes": {
    "accounts": [
      {
        "id": "gitea",
        "name": "Gitea / Forgejo",
        "selfHosted": true,
        "connect": ["token"],
        "fields": [{ "key": "url" }, { "key": "token", "secret": true }],
        "scopes": ["write:repository", "write:issue", "read:user"],
        "tokenPage": "https://codeberg.org/user/settings/applications"
      }
    ],
    "forges": [{ "id": "gitea", "name": "Gitea / Forgejo", "account": "gitea" }]
  },
  "store": { "categories": ["forges"], "docs": "docs" }
}
