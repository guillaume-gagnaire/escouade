# The store's variables (store/README.md): copy to .env for `npm run dev`; .env is never committed.
# The secrets live in Coolify, never in the repository.
DATABASE_URL=postgres://store:store@127.0.0.1:5432/store
# The base the database tests empty (npm test): never one that matters.
TEST_DATABASE_URL=
ARCHIVE_DIR=./.data/archives
NUXT_PUBLIC_SITE_URL=http://localhost:3000
# STORE-2 (accounts): without them the server starts and says what is off.
NUXT_SESSION_SECRET=
GITHUB_APP_ID=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=
STORE_ADMINS=
SMTP_URL=
MAIL_FROM=
