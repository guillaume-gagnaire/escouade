# The build context is the whole repo: only what the store needs goes in.
*
!store
!website/app/assets/main.css
!schemas
# The app's README and LICENSE: the root's, standing in for a plugin folder's in the store's trial (tests/unit/trial.test.ts).
!README.md
!LICENSE
!plugins
# The compiler of the `run.js` plugins (ESC-328): the crate of `escouade-plugin`, escouade-js, and the workspace they belong
# to, of which the image reads only the manifests (the other crates, and those of plugins/ above).
!crates
!src-tauri/Cargo.toml
!src-tauri/Cargo.lock
!src-tauri/escouade-js
!scripts/escouade-js.sh
src-tauri/escouade-js/target
crates/*/target
plugins/*/node_modules
plugins/*/packs
plugins/*/package-lock.json
store/node_modules
store/.nuxt
store/.output
store/.data
store/.env
store/test-results
store/playwright-report
