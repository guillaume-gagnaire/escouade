# The build context is the whole repo: only what the store needs goes in.
*
!store
!website/app/assets/main.css
!schemas
!plugin-examples
plugin-examples/*/node_modules
plugin-examples/*/packs
plugin-examples/*/package-lock.json
store/node_modules
store/.nuxt
store/.output
store/.data
store/.env
store/test-results
store/playwright-report
