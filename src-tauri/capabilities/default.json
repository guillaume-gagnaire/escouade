{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capabilities of the main window and of the bars of the « Pages » windows; never of a launch’s page (devpage-*), whose webview is a child of a window but is not named here",
  "webviews": ["main", "pagesbar-*"],
  "permissions": [
    "core:default",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-is-maximized",
    "core:window:allow-hide",
    "core:window:allow-show",
    "core:window:allow-set-focus",
    "core:window:allow-set-theme",
    "core:webview:allow-set-webview-zoom",
    "core:window:allow-start-dragging",
    "dialog:allow-open",
    "opener:allow-open-url",
    "opener:allow-default-urls",
    {
      "identifier": "opener:allow-open-path",
      "allow": [{ "path": "**" }, { "path": "$HOME/.escouade*" }]
    },
    "process:allow-restart"
  ]
}
