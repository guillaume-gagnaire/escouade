{
  "$id": "https://escouade.dev/schemas/plugin-1.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "activation": {
      "description": "What starts it (`event:ticket.column`, `account:github`); without any, it does not run.",
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "type": "array"
    },
    "author": {
      "properties": {
        "email": {
          "minLength": 1,
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "type": "string"
        },
        "url": {
          "pattern": "^https?://.",
          "type": "string"
        }
      },
      "required": ["name"],
      "type": "object"
    },
    "contributes": {
      "description": "Its extension points.",
      "properties": {
        "accounts": {
          "description": "A kind of account its points share.",
          "items": {
            "properties": {
              "id": {
                "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$",
                "type": "string"
              },
              "name": {
                "description": "One text, or a text by language (`en` first, then `fr`).",
                "oneOf": [
                  {
                    "minLength": 1,
                    "type": "string"
                  },
                  {
                    "additionalProperties": {
                      "type": "string"
                    },
                    "anyOf": [
                      {
                        "required": ["en"]
                      },
                      {
                        "required": ["fr"]
                      }
                    ],
                    "type": "object"
                  }
                ]
              }
            },
            "required": ["id"],
            "type": "object"
          },
          "type": "array"
        },
        "badges": {
          "description": "Reserved, with no effect in this version: Escouade shows and calls nothing of it.",
          "items": {
            "type": "object"
          },
          "type": "array"
        },
        "commands": {
          "description": "Commands run on an event.",
          "items": {
            "type": "object"
          },
          "type": "array"
        },
        "escouadeYml": {
          "description": "Reserved, with no effect in this version: read and ignored.",
          "type": "object"
        },
        "forges": {
          "description": "Code hosts: pull requests, CI, deployments.",
          "items": {
            "properties": {
              "account": {
                "description": "The id of one of `contributes.accounts`.",
                "type": "string"
              },
              "id": {
                "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$",
                "type": "string"
              },
              "name": {
                "description": "One text, or a text by language (`en` first, then `fr`).",
                "oneOf": [
                  {
                    "minLength": 1,
                    "type": "string"
                  },
                  {
                    "additionalProperties": {
                      "type": "string"
                    },
                    "anyOf": [
                      {
                        "required": ["en"]
                      },
                      {
                        "required": ["fr"]
                      }
                    ],
                    "type": "object"
                  }
                ]
              }
            },
            "required": ["id"],
            "type": "object"
          },
          "type": "array"
        },
        "groups": {
          "description": "Groups of its settings and secrets, in order, on its page.",
          "items": {
            "properties": {
              "description": {
                "description": "What it is for, under its title: one text, or a text by language.",
                "oneOf": [
                  {
                    "minLength": 1,
                    "type": "string"
                  },
                  {
                    "additionalProperties": {
                      "type": "string"
                    },
                    "anyOf": [
                      {
                        "required": ["en"]
                      },
                      {
                        "required": ["fr"]
                      }
                    ],
                    "type": "object"
                  }
                ]
              },
              "fields": {
                "description": "The keys of its settings and secrets, mixed, in the order they are shown; a key in one group at most.",
                "items": {
                  "type": "string"
                },
                "minItems": 1,
                "type": "array"
              },
              "folded": {
                "description": "Folded at first, as « Advanced ».",
                "type": "boolean"
              },
              "id": {
                "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$",
                "type": "string"
              },
              "title": {
                "description": "One text, or a text by language (`en` first, then `fr`).",
                "oneOf": [
                  {
                    "minLength": 1,
                    "type": "string"
                  },
                  {
                    "additionalProperties": {
                      "type": "string"
                    },
                    "anyOf": [
                      {
                        "required": ["en"]
                      },
                      {
                        "required": ["fr"]
                      }
                    ],
                    "type": "object"
                  }
                ]
              }
            },
            "required": ["id", "title", "fields"],
            "type": "object"
          },
          "type": "array"
        },
        "harnesses": {
          "description": "Harnesses.",
          "items": {
            "properties": {
              "account": {
                "description": "The id of one of `contributes.accounts`.",
                "type": "string"
              },
              "id": {
                "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$",
                "type": "string"
              },
              "name": {
                "description": "One text, or a text by language (`en` first, then `fr`).",
                "oneOf": [
                  {
                    "minLength": 1,
                    "type": "string"
                  },
                  {
                    "additionalProperties": {
                      "type": "string"
                    },
                    "anyOf": [
                      {
                        "required": ["en"]
                      },
                      {
                        "required": ["fr"]
                      }
                    ],
                    "type": "object"
                  }
                ]
              }
            },
            "required": ["id"],
            "type": "object"
          },
          "type": "array"
        },
        "launchEnvironments": {
          "description": "Launch environments: the up, ls, down and destroy of a worktree.",
          "items": {
            "properties": {
              "id": {
                "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$",
                "type": "string"
              },
              "name": {
                "description": "One text, or a text by language (`en` first, then `fr`).",
                "oneOf": [
                  {
                    "minLength": 1,
                    "type": "string"
                  },
                  {
                    "additionalProperties": {
                      "type": "string"
                    },
                    "anyOf": [
                      {
                        "required": ["en"]
                      },
                      {
                        "required": ["fr"]
                      }
                    ],
                    "type": "object"
                  }
                ]
              }
            },
            "required": ["id"],
            "type": "object"
          },
          "type": "array"
        },
        "menus": {
          "description": "Reserved, with no effect in this version: Escouade shows and calls nothing of it.",
          "items": {
            "type": "object"
          },
          "type": "array"
        },
        "profiles": {
          "description": "Kinds of profile: sets of fields the user makes as many times as wanted, and that each project chooses (a setting of `type: \"profile\"`). Their secrets are asked as `profile:<id>` in `permissions.secrets`.",
          "items": {
            "properties": {
              "fields": {
                "items": {
                  "properties": {
                    "description": {
                      "description": "What it is for, under its title: one text, or a text by language.",
                      "oneOf": [
                        {
                          "minLength": 1,
                          "type": "string"
                        },
                        {
                          "additionalProperties": {
                            "type": "string"
                          },
                          "anyOf": [
                            {
                              "required": ["en"]
                            },
                            {
                              "required": ["fr"]
                            }
                          ],
                          "type": "object"
                        }
                      ]
                    },
                    "import": {
                      "description": "The extensions of the files « Import a file… » offers (`.ovpn`): their text fills the field once; the path is never kept. Never from .escouade.yml.",
                      "items": {
                        "maxLength": 32,
                        "pattern": "^(\\.[A-Za-z0-9]+)+$",
                        "type": "string"
                      },
                      "type": "array"
                    },
                    "key": {
                      "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$",
                      "type": "string"
                    },
                    "lines": {
                      "description": "How many lines it shows, with `multiline`: 6 without it.",
                      "maximum": 20,
                      "minimum": 3,
                      "type": "integer"
                    },
                    "multiline": {
                      "description": "Typed on several lines (a `string` setting or a secret), 64 KiB at most.",
                      "type": "boolean"
                    },
                    "secret": {
                      "description": "Kept in the keychain, never shown again; it has no `type`.",
                      "type": "boolean"
                    },
                    "title": {
                      "description": "One text, or a text by language (`en` first, then `fr`).",
                      "oneOf": [
                        {
                          "minLength": 1,
                          "type": "string"
                        },
                        {
                          "additionalProperties": {
                            "type": "string"
                          },
                          "anyOf": [
                            {
                              "required": ["en"]
                            },
                            {
                              "required": ["fr"]
                            }
                          ],
                          "type": "object"
                        }
                      ]
                    },
                    "type": {
                      "description": "Needed unless it is `secret`.",
                      "enum": ["string", "number", "boolean", "select"]
                    }
                  },
                  "required": ["key", "title"],
                  "type": "object"
                },
                "minItems": 1,
                "type": "array"
              },
              "id": {
                "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$",
                "type": "string"
              },
              "nameField": {
                "description": "The key of the `string` field that names a profile (neither secret nor on several lines).",
                "type": "string"
              },
              "title": {
                "description": "One text, or a text by language (`en` first, then `fr`).",
                "oneOf": [
                  {
                    "minLength": 1,
                    "type": "string"
                  },
                  {
                    "additionalProperties": {
                      "type": "string"
                    },
                    "anyOf": [
                      {
                        "required": ["en"]
                      },
                      {
                        "required": ["fr"]
                      }
                    ],
                    "type": "object"
                  }
                ]
              }
            },
            "required": ["id", "title", "nameField", "fields"],
            "type": "object"
          },
          "type": "array"
        },
        "projectTemplates": {
          "description": "Reserved, with no effect in this version: Escouade shows and calls nothing of it.",
          "items": {
            "type": "object"
          },
          "type": "array"
        },
        "secrets": {
          "items": {
            "properties": {
              "description": {
                "description": "What it is for, under its title: one text, or a text by language.",
                "oneOf": [
                  {
                    "minLength": 1,
                    "type": "string"
                  },
                  {
                    "additionalProperties": {
                      "type": "string"
                    },
                    "anyOf": [
                      {
                        "required": ["en"]
                      },
                      {
                        "required": ["fr"]
                      }
                    ],
                    "type": "object"
                  }
                ]
              },
              "import": {
                "description": "The extensions of the files « Import a file… » offers (`.ovpn`): their text fills the field once; the path is never kept. Never from .escouade.yml.",
                "items": {
                  "maxLength": 32,
                  "pattern": "^(\\.[A-Za-z0-9]+)+$",
                  "type": "string"
                },
                "type": "array"
              },
              "key": {
                "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$",
                "type": "string"
              },
              "lines": {
                "description": "How many lines it shows, with `multiline`: 6 without it.",
                "maximum": 20,
                "minimum": 3,
                "type": "integer"
              },
              "multiline": {
                "description": "Typed on several lines (a `string` setting or a secret), 64 KiB at most.",
                "type": "boolean"
              },
              "repo": {
                "const": false,
                "description": "A secret never comes from .escouade.yml."
              },
              "scope": {
                "description": "`app`, the default. `project` is read but not served: the plugin stays disabled, the reason said. A secret of each project goes in a profile (`contributes.profiles`).",
                "enum": ["app", "project"]
              },
              "title": {
                "description": "One text, or a text by language (`en` first, then `fr`).",
                "oneOf": [
                  {
                    "minLength": 1,
                    "type": "string"
                  },
                  {
                    "additionalProperties": {
                      "type": "string"
                    },
                    "anyOf": [
                      {
                        "required": ["en"]
                      },
                      {
                        "required": ["fr"]
                      }
                    ],
                    "type": "object"
                  }
                ]
              }
            },
            "required": ["key", "title"],
            "type": "object"
          },
          "type": "array"
        },
        "settings": {
          "description": "Its settings, shown on its page in the order of this list, under « Settings » (or in their groups).",
          "items": {
            "properties": {
              "default": {
                "description": "Its value until the user sets one, of its type (for a `select`, one of its options); without it, empty, or false for a `boolean`."
              },
              "description": {
                "description": "Shown under its title: one text, or a text by language (`en` first, then `fr`)."
              },
              "import": {
                "description": "The extensions of the files « Import a file… » offers (`.ovpn`): their text fills the field once; the path is never kept. Never from .escouade.yml.",
                "items": {
                  "maxLength": 32,
                  "pattern": "^(\\.[A-Za-z0-9]+)+$",
                  "type": "string"
                },
                "type": "array"
              },
              "key": {
                "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$",
                "type": "string"
              },
              "lines": {
                "description": "How many lines it shows, with `multiline`: 6 without it.",
                "maximum": 20,
                "minimum": 3,
                "type": "integer"
              },
              "multiline": {
                "description": "Typed on several lines (a `string` setting or a secret), 64 KiB at most.",
                "type": "boolean"
              },
              "of": {
                "description": "With `type: \"profile\"`: the id of a kind of `contributes.profiles`.",
                "type": "string"
              },
              "options": {
                "description": "The choices of a `select`, in this order: each a value, or `{ \"value\": …, \"title\": … }` to show a title in its stead (one text, or a text by language)."
              },
              "repo": {
                "description": "`false`: its value never comes from .escouade.yml. Never `true` for a profile or an imported value.",
                "type": "boolean"
              },
              "scope": {
                "description": "Where it holds: for every project (`app`, the default), or for each one, set in the project's settings by its ranks: this machine's value, then the project's .escouade.yml, then `default` (`project`, Escouade 2.2.5 and later).",
                "enum": ["app", "project"]
              },
              "title": {
                "description": "One text, or a text by language (`en` first, then `fr`).",
                "oneOf": [
                  {
                    "minLength": 1,
                    "type": "string"
                  },
                  {
                    "additionalProperties": {
                      "type": "string"
                    },
                    "anyOf": [
                      {
                        "required": ["en"]
                      },
                      {
                        "required": ["fr"]
                      }
                    ],
                    "type": "object"
                  }
                ]
              },
              "type": {
                "description": "`profile`: one profile of the kind `of` names, chosen by the user.",
                "enum": ["string", "number", "boolean", "select", "profile"]
              }
            },
            "required": ["key", "type", "title"],
            "type": "object"
          },
          "type": "array"
        },
        "statusBar": {
          "description": "Reserved, with no effect in this version: Escouade shows and calls nothing of it.",
          "items": {
            "type": "object"
          },
          "type": "array"
        },
        "themes": {
          "description": "Themes.",
          "items": {
            "type": "object"
          },
          "type": "array"
        },
        "ticketSources": {
          "description": "Sources of the Kanban.",
          "items": {
            "properties": {
              "account": {
                "description": "The id of one of `contributes.accounts`.",
                "type": "string"
              },
              "id": {
                "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$",
                "type": "string"
              },
              "name": {
                "description": "One text, or a text by language (`en` first, then `fr`).",
                "oneOf": [
                  {
                    "minLength": 1,
                    "type": "string"
                  },
                  {
                    "additionalProperties": {
                      "type": "string"
                    },
                    "anyOf": [
                      {
                        "required": ["en"]
                      },
                      {
                        "required": ["fr"]
                      }
                    ],
                    "type": "object"
                  }
                ]
              }
            },
            "required": ["id"],
            "type": "object"
          },
          "type": "array"
        },
        "webhooks": {
          "description": "Webhooks, without code.",
          "items": {
            "type": "object"
          },
          "type": "array"
        },
        "workflowReaders": {
          "description": "Readers of workflows Escouade does not read by itself (it gives them the project's files).",
          "items": {
            "properties": {
              "files": {
                "description": "The files of the project it is given, as globs from the project's folder (`.planning/**`).",
                "items": {
                  "minLength": 1,
                  "type": "string"
                },
                "type": "array"
              },
              "id": {
                "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$",
                "type": "string"
              },
              "name": {
                "description": "One text, or a text by language (`en` first, then `fr`).",
                "oneOf": [
                  {
                    "minLength": 1,
                    "type": "string"
                  },
                  {
                    "additionalProperties": {
                      "type": "string"
                    },
                    "anyOf": [
                      {
                        "required": ["en"]
                      },
                      {
                        "required": ["fr"]
                      }
                    ],
                    "type": "object"
                  }
                ]
              }
            },
            "required": ["id", "files"],
            "type": "object"
          },
          "type": "array"
        }
      },
      "type": "object"
    },
    "description": {
      "description": "One text, or a text by language (`en` first, then `fr`).",
      "oneOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "additionalProperties": {
            "type": "string"
          },
          "anyOf": [
            {
              "required": ["en"]
            },
            {
              "required": ["fr"]
            }
          ],
          "type": "object"
        }
      ]
    },
    "escouade": {
      "description": "The Escouade it was written for: out of it, the plugin is disabled, and the reason shown.",
      "properties": {
        "api": {
          "description": "The major version of the plugins' protocol it speaks (`\"1\"`).",
          "pattern": "^[1-9][0-9]*$",
          "type": "string"
        },
        "max": {
          "pattern": "^[0-9]+(\\.[0-9]+){0,2}$",
          "type": "string"
        },
        "min": {
          "pattern": "^[0-9]+(\\.[0-9]+){0,2}$",
          "type": "string"
        }
      },
      "required": ["api", "min"],
      "type": "object"
    },
    "icon": {
      "description": "Its logo: a square PNG of its folder, 256 px a side at least (512 advised), 1 MB at most; no SVG.",
      "minLength": 1,
      "pattern": "^(?![/\\\\]|[A-Za-z]:)(?!(.*[/\\\\])?\\.\\.([/\\\\]|$))[^:]*\\.[Pp][Nn][Gg]$",
      "type": "string"
    },
    "id": {
      "description": "Unique, a reversed domain name (`dev.exemple.slack`); `dev.escouade.*` is kept for Escouade's own plugins.",
      "maxLength": 100,
      "pattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?(\\.[a-z0-9]([a-z0-9-]*[a-z0-9])?)+$",
      "type": "string"
    },
    "license": {
      "description": "An SPDX identifier (`MIT`).",
      "minLength": 1,
      "type": "string"
    },
    "limits": {
      "description": "What a plugin in WASM asks for beyond the host's defaults; Escouade caps them at 120 s and 32 MiB for `net/fetch`, 4 MiB for `fs/read`, 256 MiB for its memory, 10 s for a turn.",
      "properties": {
        "fetchBytes": {
          "minimum": 1,
          "type": "integer"
        },
        "fetchSeconds": {
          "minimum": 1,
          "type": "integer"
        },
        "fileBytes": {
          "description": "How much `fs/read` gives at most: 256 KiB without it.",
          "maximum": 4194304,
          "minimum": 1,
          "type": "integer"
        },
        "memoryBytes": {
          "description": "How much linear memory its instance may take: 64 MiB without it.",
          "maximum": 268435456,
          "minimum": 1,
          "type": "integer"
        },
        "processes": {
          "description": "How many programs it may run at once (`proc/spawn`), for the plugin, all projects together: 4 without it, 16 at most. Beyond 4, said at its install and with `reason`; an update that raises it asks again (Escouade 2.2.5 and later: an older one keeps 4).",
          "maximum": 16,
          "minimum": 1,
          "type": "integer"
        },
        "reason": {
          "description": "Why it asks for more programs at once, in a sentence: needed with `processes` beyond 4.",
          "oneOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "additionalProperties": {
                "type": "string"
              },
              "type": "object"
            }
          ]
        },
        "turnSeconds": {
          "description": "How long a turn of its instance may take: 2 s without it.",
          "maximum": 10,
          "minimum": 1,
          "type": "integer"
        }
      },
      "type": "object"
    },
    "name": {
      "description": "One text, or a text by language (`en` first, then `fr`).",
      "oneOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "additionalProperties": {
            "type": "string"
          },
          "anyOf": [
            {
              "required": ["en"]
            },
            {
              "required": ["fr"]
            }
          ],
          "type": "object"
        }
      ]
    },
    "permissions": {
      "description": "What it asks for, shown before it is installed.",
      "properties": {
        "commands": {
          "description": "The programs it may run (`proc/spawn`): a program's name, never a path nor a joker, then its arguments, word for word. A joker stands for one word of a closed form, written whole, never an option: `{int}`, `{port}`, `{name}`, `{pid}` (a program it runs), `{path:temp}`, `{path:plugin}` (a file of that folder, given as its real path); no other brace (Escouade 2.2.5 and later: an older one matches nothing). A last word `*` lets any more follow.",
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "type": "array"
        },
        "decide": {
          "type": "boolean"
        },
        "env": {
          "description": "The variables it may set on what it runs (`proc/spawn`, the launches of its harnesses), shown before it is installed; any other is refused. Never Escouade's own nor `LD_*`, `DYLD_*`, `GIT_*` (but `GIT_AUTHOR_*`, `GIT_COMMITTER_*`), `PYTHON*`, `RUBY*`, `PERL*`, `NODE_*`, `JAVA_TOOL_OPTIONS`, `npm_config_*`, `*_PROXY`, `SSL_*`, `XDG_*`, `HOME`, `USERPROFILE`, `APPDATA`, `PATH`.",
          "items": {
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
            "type": "string"
          },
          "type": "array"
        },
        "events": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "type": "array"
        },
        "files": {
          "description": "The folders it may read or write (`fs/*`): a root of the closed list, which the host resolves; no path of its own. `plugin` is read only.",
          "items": {
            "properties": {
              "access": {
                "enum": ["read", "write"]
              },
