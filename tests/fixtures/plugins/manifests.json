{
  "about": "The manifests of escouade-plugin.json and what their reader says of them (ESC-173). Both readers go through every case: the app's (src-tauri/src/plugins/manifest_tests.rs) and the store's library (schemas/plugin-manifest.test.ts). `errors` are `<path> <code>`, in any order; `ignored` the unknown fields, which load nothing and fail nothing. `files` are the files of the plugin's folder a case reads (its `icon`): `png` a PNG's header of that width and height, padded to `size` bytes; `text` a file of that text.",
  "cases": [
    {
      "name": "the manifest of docs/PLUGINS.md §3.1",
      "manifest": {
        "$schema": "https://escouade.dev/schemas/plugin-1.json",
        "id": "dev.exemple.slack",
        "name": "Slack",
        "version": "1.2.0",
        "description": {
          "fr": "Les tickets à tester et les agents qui attendent, dans un salon Slack.",
          "en": "Tickets to test and agents waiting, in a Slack channel."
        },
        "author": {
          "name": "Exemple",
          "url": "https://exemple.dev"
        },
        "license": "MIT",
        "repository": "https://github.com/exemple/escouade-slack",
        "escouade": {
          "api": "1",
          "min": "2.1.0"
        },
        "run": {
          "command": "bin/escouade-slack",
          "windows": "bin/escouade-slack.exe"
        },
        "activation": ["event:ticket.column", "event:agent.waiting"],
        "permissions": {
          "events": ["ticket.*", "agent.waiting"],
          "network": ["hooks.slack.com"],
          "secrets": ["webhook"]
        },
        "contributes": {
          "settings": [
            {
              "key": "channel",
              "type": "string",
              "title": {
                "fr": "Salon",
                "en": "Channel"
              }
            }
          ],
          "secrets": [
            {
              "key": "webhook",
              "title": {
                "fr": "Adresse du webhook",
                "en": "Webhook URL"
              }
            }
          ]
        }
      },
      "errors": [],
      "ignored": []
    },
