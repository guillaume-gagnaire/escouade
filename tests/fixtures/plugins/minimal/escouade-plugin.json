{
  "$schema": "https://escouade.dev/schemas/plugin-1.json",
  "id": "dev.escouade.minimal",
  "name": "Minimal",
  "version": "0.0.0",
  "description": {
    "fr": "Le plugin de démonstration des builds de développement et des tests : le moins qu'un plugin de la première main fasse, un module, pour prouver le chemin du registre à une instance.",
    "en": "The demonstration plugin of the builds of development and the tests: the least a plugin of the first hand does, a module, to prove the way from the registry to an instance."
  },
  "author": {
    "name": "Escouade",
    "url": "https://escouade.dev"
  },
  "license": "GPL-3.0-or-later",
  "repository": "https://github.com/guillaume-gagnaire/escouade/tree/main/tests/fixtures/plugins/minimal",
  "escouade": {
    "api": "1",
    "min": "2.1.0"
  },
  "run": {
    "wasm": "Cargo.toml"
  },
  "activation": ["event:ticket.column"],
  "permissions": {
    "events": ["ticket.column"],
    "files": [
      {
        "root": "agent",
        "access": "write"
      }
    ]
  },
  "contributes": {
    "harnesses": [
      {
        "id": "minimal",
        "name": "Minimal",
        "speaker": "Minimal",
        "locate": {
          "names": ["fake-minimal"]
        },
        "tested": {
          "oldest": "0",
          "newest": "0"
        },
        "caps": {
          "modes": ["default"],
          "readOnly": true
        },
        "models": [
          {
            "id": "grand",
            "label": "Grand"
          },
          {
            "id": "petit",
            "label": "Petit"
          }
        ],
        "accountVar": "MINIMAL_HOME",
        "memory": {
          "dir": "{configDir}/projects/{projectKey}/memory"
        }
      }
    ]
  }
}
