{
  "name": "{{package}}",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "esbuild src/main.ts --bundle --platform=node --format=esm --target=node20 --outfile=dist/plugin.mjs",
    "typecheck": "tsc",
    "test": "node --test test/*.test.ts",
    "validate": "escouade-plugin validate .",
    "bench": "npm run build && escouade-plugin test .",
    "dev": "npm run build && escouade-plugin dev .",
    "archive": "npm run build && escouade-plugin pack ."
  },
  "devDependencies": {
    "@escouade-dev/plugin": "{{sdk}}",
    "@types/node": "^22.0.0",
    "esbuild": "^0.25.0",
    "typescript": "^6.0.0"
  }
}
