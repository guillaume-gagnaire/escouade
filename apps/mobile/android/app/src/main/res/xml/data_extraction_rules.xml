<?xml version="1.0" encoding="utf-8"?>
<!--
  MO-1 (docs/MOBILE.md § 12): nothing of the app leaves the phone in a backup or a transfer to another device; a space's
  key and token stay in the Keystore, bound to this phone (MO-4).
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
