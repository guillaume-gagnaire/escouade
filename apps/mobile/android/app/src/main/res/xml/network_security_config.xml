<?xml version="1.0" encoding="utf-8"?>
<!--
  MO-1 (docs/MOBILE.md § 3.13): no cleartext anywhere, but to the tunnel's proxy of the app itself, on the phone's
  loopback (127.0.0.1, a port drawn by the system), where the WebSocket of each space goes into its WireGuard tunnel.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
